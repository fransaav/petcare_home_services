C4Component
    title Diagrama de Componentes: API Monolítica PetCare

    Container(app, "Mobile App", "Flutter", "Aplicación cliente")
    ContainerDb(db, "Base de Datos", "SQL Server 2022", "Almacenamiento relacional")

    Container_Boundary(api_boundary, "API Monolítica (.NET 10)") {
        Component(controllers, "Capa API (Controladores)", "ASP.NET Core", "Expone endpoints REST y rutea las peticiones.")
        Component(services, "Capa Application (Servicios)", "C#", "Implementa casos de uso y lógica de negocio mediante Inyección de Dependencias.")
        Component(repositories, "Capa Infrastructure (Repositorios)", "C#, EF Core", "Implementa el acceso a datos y encapsula el DbContext.")
        Component(domain, "Capa Domain (Entidades)", "C# POCOs", "Contiene las entidades core (Customer, Pet, Booking, Provider, Payment) sin dependencias externas.")
    }

    Rel(app, controllers, "Llama a endpoints REST", "JSON/HTTPS")
    
    Rel(controllers, services, "Delega peticiones a", "Interfaces (ICustomerService, etc.)")
    Rel(services, repositories, "Orquesta persistencia a través de", "Interfaces (ICustomerRepository, etc.)")
    
    Rel(repositories, db, "Realiza operaciones SQL", "TCP/1433")
    
    UpdateRelStyle(controllers, services, $offsetX="-40", $offsetY="-20")
    
    %% Relaciones hacia el Dominio (Dependencia de todas las capas hacia adentro)
    Rel_Back(domain, controllers, "Usa modelos de", "Dependencia directa")
    Rel_Back(domain, services, "Usa modelos de", "Dependencia directa")
    Rel_Back(domain, repositories, "Usa/Mapea modelos de", "Dependencia directa")