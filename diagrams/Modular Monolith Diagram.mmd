
C4Component
    title Component diagram for PetCare Home Services - Modular Monolith

    Person(customer, "Customer", "A pet owner who wants to book services.")
    Person(provider, "Provider", "A professional providing pet services.")

    System_Boundary(c1, "PetCare Home Services") {
        
        Container_Boundary(api, "Backend API (Modular Monolith)") {
            Component(mod_identity, "IdentityAndPets Module", ".NET Class Library", "Manages customers and their pets.")
            Component(mod_booking, "Booking Module", ".NET Class Library", "Manages service bookings and scheduling.")
            Component(mod_providers, "Providers Module", ".NET Class Library", "Manages service providers and availability.")
            Component(mod_billing, "Billing Module", ".NET Class Library", "Manages payments and billing.")
            
            Rel(mod_booking, mod_identity, "Uses", "In-process method call")
            Rel(mod_booking, mod_providers, "Uses", "In-process method call")
        }

        Container_Boundary(db, "SQL Server Database") {
            ComponentDb(schema_identity, "Identity Schema", "SQL Server Schema", "Stores customers and pets.")
            ComponentDb(schema_booking, "Booking Schema", "SQL Server Schema", "Stores bookings.")
            ComponentDb(schema_providers, "Providers Schema", "SQL Server Schema", "Stores providers.")
            ComponentDb(schema_billing, "Billing Schema", "SQL Server Schema", "Stores payments.")
        }
    }

    Rel(customer, mod_identity, "Manages profile & pets using", "HTTPS/JSON")
    Rel(customer, mod_booking, "Books services using", "HTTPS/JSON")
    Rel(customer, mod_billing, "Pays for services using", "HTTPS/JSON")
    Rel(provider, mod_providers, "Manages availability using", "HTTPS/JSON")
    Rel(provider, mod_booking, "Accepts/Updates bookings using", "HTTPS/JSON")

    Rel(mod_identity, schema_identity, "Reads from and writes to", "EF Core")
    Rel(mod_booking, schema_booking, "Reads from and writes to", "EF Core")
    Rel(mod_providers, schema_providers, "Reads from and writes to", "EF Core")
    Rel(mod_billing, schema_billing, "Reads from and writes to", "EF Core")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")